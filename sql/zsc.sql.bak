-- ----------------------------
-- Procedure structure for GlobalSearch
-- ----------------------------
DROP PROCEDURE IF EXISTS `GlobalSearch`;
delimiter ;;
CREATE PROCEDURE `GlobalSearch`(IN SearchStr VARCHAR(200))
BEGIN
    DECLARE Done INT DEFAULT 0;
    DECLARE TableName VARCHAR(100);
    DECLARE ColumnName VARCHAR(100);
    
    DECLARE Cur1 CURSOR FOR
        SELECT TABLE_NAME, COLUMN_NAME
        FROM INFORMATION_SCHEMA.COLUMNS
        WHERE TABLE_SCHEMA = 'zsc'
        AND DATA_TYPE IN ('varchar', 'char', 'text', 'mediumtext', 'longtext');
    
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET Done = 1;
    
    OPEN Cur1;
    
    ReadLoop: LOOP
        FETCH Cur1 INTO TableName, ColumnName;
        IF Done THEN
            LEAVE ReadLoop;
        END IF;
        
        SET @Query = CONCAT(
            'SELECT ''', TableName, ''' AS TableName, ''', ColumnName, ''' AS ColumnName, ',
            ColumnName, ' AS Content FROM ', TableName,
            ' WHERE ', ColumnName, ' LIKE ''%', SearchStr, '%'' LIMIT 10'
        );
        
        PREPARE stmt FROM @Query;
        EXECUTE stmt;
        DEALLOCATE PREPARE stmt;
    END LOOP;
    
    CLOSE Cur1;
END
;;
delimiter ;

SET FOREIGN_KEY_CHECKS = 1;
