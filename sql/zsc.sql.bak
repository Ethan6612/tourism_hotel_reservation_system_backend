SET NAMES utf8mb4;
SET FOREIGN_KEY_CHECKS = 0;

-- ----------------------------
-- Table structure for biz_category
-- ----------------------------
DROP TABLE IF EXISTS `biz_category`;
CREATE TABLE `biz_category`  (
  `category_id` bigint NOT NULL AUTO_INCREMENT COMMENT '类别ID',
  `category_name` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NOT NULL COMMENT '类别名称',
  `sort_order` int NULL DEFAULT 0 COMMENT '排序',
  `status` char(1) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT '0' COMMENT '状态（0正常 1停用）',
  `create_time` datetime NULL DEFAULT NULL COMMENT '创建时间',
  `update_time` datetime NULL DEFAULT NULL COMMENT '更新时间',
  PRIMARY KEY (`category_id`) USING BTREE
) ENGINE = InnoDB CHARACTER SET = utf8mb4 COLLATE = utf8mb4_0900_ai_ci COMMENT = '业务类别表' ROW_FORMAT = DYNAMIC;

-- ----------------------------
-- Records of biz_category
-- ----------------------------

-- ----------------------------
-- Table structure for comment
-- ----------------------------
DROP TABLE IF EXISTS `comment`;
CREATE TABLE `comment`  (
  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '评价ID',
  `user_id` bigint NOT NULL COMMENT '用户ID',
  `hotel_id` bigint NOT NULL COMMENT '酒店ID',
  `room_id` bigint NULL DEFAULT NULL COMMENT '房型ID（可选）',
  `order_id` bigint NULL DEFAULT NULL COMMENT '订单ID（关联预订记录，校验入住完成）',
  `score` int NOT NULL DEFAULT 5 COMMENT '评分（1-5星）',
  `content` text CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL COMMENT '评价内容',
  `images` text CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL COMMENT '评价图片，JSON数组格式存储多个图片URL',
  `is_anonymous` char(1) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT '0' COMMENT '是否匿名评价（0=否 1=是）',
  `status` char(1) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT '0' COMMENT '评价状态（0=待审核 1=已发布 2=已拒绝）',
  `like_count` int NULL DEFAULT 0 COMMENT '点赞数',
  `reply_content` text CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL COMMENT '商家回复内容',
  `reply_time` datetime NULL DEFAULT NULL COMMENT '回复时间',
  `reply_by` bigint NULL DEFAULT NULL COMMENT '回复人ID',
  `create_by` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT '' COMMENT '创建者',
  `create_time` datetime NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `update_by` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT '' COMMENT '更新者',
  `update_time` datetime NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
  `remark` varchar(500) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL COMMENT '备注',
  `appeal_reason` text CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL COMMENT '申诉理由',
  `appeal_time` datetime NULL DEFAULT NULL COMMENT '申诉时间',
  `appeal_status` char(1) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT '0' COMMENT '申诉状态（0=无申诉 1=申诉中 2=申诉通过 3=申诉驳回）',
  PRIMARY KEY (`id`) USING BTREE,
  INDEX `idx_user_id`(`user_id` ASC) USING BTREE,
  INDEX `idx_hotel_id`(`hotel_id` ASC) USING BTREE,
  INDEX `idx_room_id`(`room_id` ASC) USING BTREE,
  INDEX `idx_order_id`(`order_id` ASC) USING BTREE,
  INDEX `idx_status`(`status` ASC) USING BTREE,
  INDEX `idx_score`(`score` ASC) USING BTREE,
  INDEX `idx_create_time`(`create_time` ASC) USING BTREE,
  INDEX `idx_appeal_status`(`appeal_status` ASC) USING BTREE
) ENGINE = InnoDB AUTO_INCREMENT = 37 CHARACTER SET = utf8mb4 COLLATE = utf8mb4_0900_ai_ci COMMENT = '评价表' ROW_FORMAT = DYNAMIC;

-- ----------------------------
-- Records of comment
-- ----------------------------
INSERT INTO `comment` VALUES (1, 100, 1, 1, 1, 5, '酒店位置非常好，就在王府井大街，出行很方便。房间干净整洁，服务人员态度热情周到，早餐品种丰富，下次还会再来！', '[\"https://example.com/comment_img1.jpg\",\"https://example.com/comment_img2.jpg\"]', '0', '1', 12, '感谢您的认可！期待您的再次光临，我们将一如既往地为您提供优质服务。', '2026-05-29 21:21:37', 1, 'zhangsan', '2026-01-15 10:30:00', '', '2026-05-29 21:21:37', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (2, 100, 1, 2, 2, 4, '整体体验不错，房间空间很大，设施也比较新。唯一不足的是晚上有些噪音，隔音效果一般。', '[]', '0', '1', 5, '感谢您的反馈，关于隔音问题我们已经着手改善，给您带来不便深表歉意。', '2026-05-29 21:21:37', 1, 'zhangsan', '2026-01-20 14:20:00', '', '2026-05-29 21:21:37', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (3, 2, 1, 1, 3, 5, '非常棒的住宿体验！前台小姐姐服务很好，还给免费升级了房型，酒店设施齐全，健身房和游泳池都很棒。', '[\"https://example.com/comment_img3.jpg\"]', '0', '1', 8, NULL, NULL, NULL, 'ry', '2026-02-01 09:15:00', '', '2026-05-29 21:21:37', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (4, 100, 2, 5, 4, 5, '外滩景观绝佳，从房间就能看到黄浦江美景。酒店装修典雅奢华，服务堪称完美，是上海最值得入住的酒店之一。', '[\"https://example.com/comment_img4.jpg\",\"https://example.com/comment_img5.jpg\",\"https://example.com/comment_img6.jpg\"]', '0', '1', 20, '感谢您的赞美！华尔道夫一直致力于为宾客打造难忘的入住体验。', '2026-05-29 21:21:37', 1, 'zhangsan', '2026-02-10 16:45:00', '', '2026-05-29 21:21:37', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (5, 2, 2, 6, 5, 3, '酒店环境确实不错，但价格偏高，性价比一般。餐厅菜品口味中规中矩，没有特别惊艳的感觉。', '[]', '1', '1', 3, '感谢您的评价，我们会根据您的建议改进菜品质量，希望能再次为您服务。', '2026-05-29 21:21:37', 1, 'ry', '2026-02-15 11:00:00', '', '2026-05-29 21:21:37', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (6, 100, 3, 9, 6, 4, '广州塔附近，地理位置优越。房间可以看到珠江夜景，非常漂亮。服务也不错，只是退房时稍微等了一会儿。', '[\"https://example.com/comment_img7.jpg\"]', '0', '1', 6, NULL, NULL, NULL, 'zhangsan', '2026-02-20 20:30:00', '', '2026-05-29 21:21:37', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (7, 2, 3, 10, 7, 5, '丽思卡尔顿一如既往的高品质！从大堂到客房每个细节都做得很好，儿童乐园孩子玩得很开心，亲子游首选。', '[]', '0', '1', 15, '很高兴您和家人在这里度过了愉快的时光，欢迎再次光临！', '2026-05-29 21:21:37', 1, 'ry', '2026-03-05 13:10:00', '', '2026-05-29 21:21:37', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (8, 100, 4, 13, 8, 4, '福田中心位置，交通便利，周边商场和餐厅很多。房间面积适中，干净卫生，就是泳池水有点凉。', '[\"https://example.com/comment_img8.jpg\"]', '0', '1', 4, '感谢您的建议，我们已经调整了泳池水温，期待您的再次体验。', '2026-05-29 21:21:37', 1, 'zhangsan', '2026-03-12 08:50:00', '', '2026-05-29 21:21:37', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (9, 2, 4, 14, 9, 2, '这次住宿体验不太好。入住时房间还没打扫好，等了快一个小时。而且空调噪音很大，影响休息。', '[]', '0', '1', 7, '非常抱歉给您带来不愉快的体验！我们已经对相关人员进行了培训，空调已安排维修。希望能有机会重新为您服务。', '2026-05-29 21:21:37', 1, 'ry', '2026-03-18 22:15:00', '', '2026-05-29 21:21:37', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (10, 100, 5, 17, 10, 5, '西湖边的酒店就是不一样！环境优美，花园精致，房间古色古香很有韵味。漫步在杨公堤上，感受杭州的诗情画意。', '[\"https://example.com/comment_img9.jpg\",\"https://example.com/comment_img10.jpg\"]', '0', '1', 25, '感谢您如此诗意的评价！国宾馆欢迎您随时回来感受西湖四季之美。', '2026-05-29 21:21:37', 1, 'zhangsan', '2026-04-01 07:30:00', '', '2026-05-29 21:21:37', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (11, 2, 5, 18, 11, 4, '酒店环境很好，就在西湖景区内，早起可以沿着湖边散步。房间设施有些年头了，但保养得还不错。', '[]', '0', '1', 3, NULL, NULL, NULL, 'ry', '2026-04-08 10:00:00', '', '2026-05-29 21:21:37', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (12, 100, 6, 21, 12, 5, '成都的酒店就是舒服！太古里旁边逛街方便，酒店设计现代时尚，房间视野极佳。必须点赞前台小哥哥的贴心服务！', '[\"https://example.com/comment_img11.jpg\"]', '0', '1', 18, '谢谢您的喜欢！成都永远欢迎您，我们也会把您的表扬转达给前台同事。', '2026-05-29 21:21:37', 1, 'zhangsan', '2026-04-15 15:20:00', '', '2026-05-29 21:21:37', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (13, 2, 6, 22, 13, 4, '位置很好，出门就是太古里。早餐种类多，有地道的四川小吃。房间隔音不错，睡得很安稳。', '[]', '1', '1', 2, NULL, NULL, NULL, 'ry', '2026-04-20 12:00:00', '', '2026-05-29 21:21:37', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (14, 100, 7, 25, 14, 4, '钟楼附近的酒店，位置绝佳，步行就能到达回民街。房间整洁，价格实惠，性价比很高的选择。', '[]', '0', '1', 9, '感谢您的认可，我们致力于为每位客人提供高性价比的住宿体验。', '2026-05-29 21:21:37', 1, 'zhangsan', '2026-05-01 18:30:00', '', '2026-05-29 21:21:37', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (15, 2, 8, 29, 15, 5, '三亚度假首选！私人沙滩人少干净，服务超级贴心，每个员工都会微笑问好。海景套房太美了，躺床上就能看日出！', '[\"https://example.com/comment_img12.jpg\",\"https://example.com/comment_img13.jpg\",\"https://example.com/comment_img14.jpg\"]', '0', '1', 30, '感谢您的满分好评！瑞吉致力于打造完美的度假体验，期待与您再次相遇在三亚！', '2026-05-29 21:21:37', 1, 'ry', '2026-05-10 06:45:00', '', '2026-05-29 21:21:37', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (16, 100, 8, 30, 16, 4, '亚龙湾的海水真的蓝得让人心醉。酒店设施很齐全，儿童俱乐部孩子很喜欢。唯一遗憾是离市区较远，出门需要打车。', '[\"https://example.com/comment_img15.jpg\"]', '0', '1', 11, NULL, NULL, NULL, 'zhangsan', '2026-05-18 21:00:00', '', '2026-05-29 21:21:37', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (17, 2, 9, 33, 17, 5, '鼓浪屿上的海景酒店太浪漫了！早上被海浪声唤醒，阳台上就能看到日出。酒店还提供免费自行车环岛游，强烈推荐！', '[\"https://example.com/comment_img16.jpg\"]', '0', '1', 22, '感谢您的推荐！鼓浪屿的日出确实美不胜收，很高兴您在这里留下美好回忆。', '2026-05-29 21:21:37', 1, 'ry', '2026-05-22 08:00:00', '', '2026-05-29 21:21:37', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (18, 100, 10, 37, 18, 4, '五四广场旁边，青岛核心地段。海景房可以直接看到大海和五四广场。设施维护得不错，早餐海鲜粥很好喝。', '[]', '0', '1', 5, '感谢您的好评，青岛的海鲜粥确实是我们的特色之一！', '2026-05-29 21:21:37', 1, 'zhangsan', '2026-05-25 11:30:00', '', '2026-05-29 21:21:37', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (19, 103, 1, 1, 101, 5, '第一次来北京出差选择了这家酒店，果然没让我失望！从机场打车过来很方便，酒店就在王府井旁边，步行就能到天安门。房间非常宽敞整洁，床品舒适度满分。早餐种类多到吃不过来，尤其是那个手工馄饨特别好吃。前台服务非常专业，还帮忙升级了房型。下次来北京还会选择这里！', '[\"https://images.unsplash.com/photo-1566073771259-6a8506099945?w=400&h=300&fit=crop\",\"https://images.unsplash.com/photo-1551882547-be7b2a60087d?w=400&h=300&fit=crop\"]', '0', '1', 15, '感谢您的详细好评！我们很高兴能为您提供满意的住宿体验，手工馄饨是我们的特色早餐之一。期待您的再次光临！', '2026-06-02 14:30:00', 1, 'user103', '2026-05-10 09:00:00', '', '2026-06-02 14:30:00', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (20, 103, 5, 17, 102, 4, '西湖边的酒店环境是真的好，早上起来在杨公堤上散步特别惬意。房间是中式风格装修，古色古香很有韵味。服务人员都很热情，主动帮忙提行李。唯一的遗憾是房间设施稍微有些老旧，空调声音稍微大了点。不过整体体验还是很棒的，这个位置这个价格很值了。', '[\"https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=400&h=300&fit=crop\"]', '0', '1', 8, '感谢您的评价和建议！关于空调噪音的问题我们已经反馈给工程部，会尽快排查改善。期待您下次再来感受西湖四季之美！', '2026-06-03 10:15:00', 1, 'user103', '2026-05-22 16:00:00', '', '2026-06-03 10:15:00', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (21, 103, 6, 21, 103, 5, '成都就是巴适！这家酒店位置太好了，出门就是太古里和IFS，逛街吃饭都超级方便。酒店设计感很强，现代时尚风格很适合年轻人。房间视野很棒，可以看到整个市中心的天际线。特别要夸一下前台小哥哥，特别热情地给我们推荐了周边的地道火锅店，太好吃了！下次来成都还要住这里！', '[\"https://images.unsplash.com/photo-1551882547-be7b2a60087d?w=400&h=300&fit=crop\",\"https://images.unsplash.com/photo-1566073771259-6a8506099945?w=400&h=300&fit=crop\",\"https://images.unsplash.com/photo-1523961131990-5ea7c61b2107?w=400&h=300&fit=crop\"]', '0', '1', 22, NULL, NULL, NULL, 'user103', '2026-06-05 20:00:00', '', '2026-06-05 20:00:00', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (22, 104, 1, 2, 104, 5, '北京希尔顿地理位置绝佳，步行到王府井和故宫都很方便。酒店大堂非常气派，房间装修也很新。特别满意的是早餐，种类非常丰富，中餐西餐都有。健身房设施齐全，游泳池也很干净。下次来北京出差还会选择这里。', '[\"https://images.unsplash.com/photo-1566073771259-6a8506099945?w=400&h=300&fit=crop\"]', '0', '1', 11, '感谢您的肯定！我们会继续努力为宾客提供优质服务！', '2026-06-06 09:20:00', 1, 'user104', '2026-06-01 14:00:00', '', '2026-06-06 09:20:00', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (23, 104, 2, 5, 105, 3, '上海华尔道夫酒店的环境确实不错，外滩景观无敌。但是价格偏高，性价比一般。房间设施虽然豪华但感觉有些年头了，浴室的淋浴水压不太稳定。服务人员的态度还是很好的，只是这个价位期望值会更高一些。', '[]', '0', '1', 3, '感谢您的反馈，关于淋浴水压问题我们已经安排工程部检查。华尔道夫一直致力于为客人提供最好的体验，您的意见对我们很重要。', '2026-06-04 11:00:00', 1, 'user104', '2026-06-02 10:00:00', '', '2026-06-04 11:00:00', '水压问题夸大其词，其他客人都说正常', '2026-06-05 15:00:00', '1');
INSERT INTO `comment` VALUES (24, 105, 3, 10, 106, 4, '广州丽思卡尔顿给我的整体感觉很好，珠江夜景美不胜收。房间空间很大，尤其喜欢那个落地窗，视野非常开阔。唯一扣分的地方是办理入住时等了一会儿，前台效率可以提高一些。不过瑕不掩瑜，还是很推荐的。', '[\"https://images.unsplash.com/photo-1559656914944-3d2426425947?w=400&h=300&fit=crop\"]', '0', '1', 7, NULL, NULL, NULL, 'user105', '2026-06-03 18:00:00', '', '2026-06-03 18:00:00', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (25, 105, 2, 6, 107, 2, '说实话有些失望。冲着华尔道夫的名气来的，但实际体验远不如预期。房间安排在电梯旁边，整晚都能听到电梯运行的声音。早餐种类虽然多但品质一般，水果不是很新鲜。对于这个价位的酒店来说完全不及格。', '[]', '1', '1', 5, '非常抱歉给您带来了不愉快的体验！我们已经记录了您的反馈，会严肃处理噪音问题并加强早餐品质管理。希望能有机会重新为您服务。', '2026-06-05 16:30:00', 1, NULL, '2026-05-28 08:00:00', '', '2026-06-05 16:30:00', '客人反馈不属实，我们当天安排了远离电梯的房间', '2026-06-06 10:00:00', '1');
INSERT INTO `comment` VALUES (26, 106, 4, 13, 108, 4, '香格里拉的服务一如既往地好。福田中心位置，周边商圈很繁华。房间干净整洁，床特别舒服。健身房设备齐全，游泳池也不错。早餐的广式点心很好吃，下次还会来住。', '[\"https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?w=400&h=300&fit=crop\"]', '0', '1', 6, '感谢您的入住与好评！香格里拉欢迎您再次光临！', '2026-06-06 14:00:00', 1, 'user106', '2026-06-04 12:00:00', '', '2026-06-06 14:00:00', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (27, 106, 7, 25, 109, 5, '西安钟楼附近的酒店，位置绝佳。走出酒店就是钟楼和回民街，各种美食吃到停不下来。酒店装修很有古城特色，房间虽然不算大但很温馨。前台小姐姐特别热情，还帮忙规划了游玩路线。性价比很高，强烈推荐！', '[\"https://images.unsplash.com/photo-1508804185872-d7badad00f7d?w=400&h=300&fit=crop\",\"https://images.unsplash.com/photo-1523961131990-5ea7c61b2107?w=400&h=300&fit=crop\"]', '0', '1', 14, '谢谢您的推荐！很高兴我们的服务能让您的西安之旅更加愉快。', '2026-06-07 08:00:00', 1, 'user106', '2026-06-05 20:00:00', '', '2026-06-07 08:00:00', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (28, 101, 8, 30, 110, 5, '三亚度假的完美选择！私人沙滩人少又干净，躺在沙滩椅上看着碧海蓝天，太惬意了。海景套房视野绝佳，早上躺在床上就能看到日出。酒店的餐饮也很棒，海鲜自助非常新鲜。一定会再来的！', '[\"https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=400&h=300&fit=crop\"]', '0', '1', 28, '感谢您的满分好评！三亚的美景和我们的服务期待您的再次光临！', '2026-06-06 10:00:00', 1, 'user101', '2026-05-30 09:00:00', '', '2026-06-06 10:00:00', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (29, 101, 3, 9, 111, 4, '广州出差选择了丽思卡尔顿，总体体验不错。酒店位置很好，珠江新城核心区域，商务出行很方便。房间设施齐全，写字台很大适合办公。不过WIFI速度有时候不太稳定，开会时有些尴尬。', '[]', '0', '1', 4, NULL, NULL, NULL, 'user101', '2026-06-02 16:00:00', '', '2026-06-02 16:00:00', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (30, 102, 5, 18, 112, 5, '杭州西湖国宾馆真是名不虚传！环境太美了，园林设计精致典雅，感觉自己住在画里。房间古色古香但设施现代化，床品舒适。早餐在湖边餐厅吃，看着西湖晨雾慢慢散去，太享受了。这次住了两晚，下次要住一周！', '[\"https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=400&h=300&fit=crop\",\"https://images.unsplash.com/photo-1566073771259-6a8506099945?w=400&h=300&fit=crop\"]', '0', '1', 19, '您的评价让我们倍感温暖！国宾馆的每个角落都蕴含着西湖的诗意，期待您下次来感受西湖的四季之美。', '2026-06-07 09:00:00', 1, 'user102', '2026-06-03 07:00:00', '', '2026-06-07 09:00:00', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (31, 102, 6, 22, 113, 3, '酒店设计感不错，位置也很好在太古里旁边。但是入住体验有些小问题：空调制冷效果一般，调到最低温度房间还是不够凉快。隔音也不是很好，能听到隔壁房间的说话声。希望酒店能在硬件方面再加强一些。', '[]', '0', '1', 2, '感谢您的反馈。关于空调和隔音问题，我们已经安排工程部进行全面排查。给您带来的不便深表歉意。', '2026-06-05 13:00:00', 1, 'user102', '2026-06-04 11:00:00', '', '2026-06-05 13:00:00', '隔壁房客已退房，空调也正常运行', '2026-06-06 16:00:00', '1');
INSERT INTO `comment` VALUES (32, 107, 9, 33, 114, 4, '鼓浪屿上的酒店，位置很特别，需要坐轮渡上岛。酒店环境很好，花园打理得很漂亮。房间虽然不大但布置得很温馨，有文艺气息。早餐供应到10点很贴心。唯一的不足是岛上晚上比较安静，娱乐设施少了一些。', '[\"https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=400&h=300&fit=crop\"]', '0', '1', 5, NULL, NULL, NULL, 'user107', '2026-06-01 15:00:00', '', '2026-06-01 15:00:00', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (33, 107, 10, 37, 115, 5, '青岛海景酒店太棒了！五四广场旁边，海景房可以直接看到大海。酒店设施维护得很好，房间干净卫生。早餐的海鲜粥是特色，一定要尝尝。服务人员热情周到，主动帮忙提行李。性价比很高，下次还会来！', '[\"https://images.unsplash.com/photo-1551882547-be7b2a60087d?w=400&h=300&fit=crop\"]', '0', '1', 10, '谢谢您的喜欢！青岛的海鲜粥确实是我们的招牌，很高兴您能品尝到。期待您的再次光临！', '2026-06-06 12:00:00', 1, 'user107', '2026-05-29 10:00:00', '', '2026-06-06 12:00:00', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (34, 108, 1, 1, 116, 5, '北京希尔顿的服务真的没话说，从门童到前台每一位员工都面带微笑。房间干净整洁，床品非常舒适。特别要表扬一下行政酒廊的工作人员，下午茶和晚间鸡尾酒时段都非常用心。这次带着父母来的，他们也很满意。', '[\"https://images.unsplash.com/photo-1566073771259-6a8506099945?w=400&h=300&fit=crop\"]', '0', '1', 8, '很高兴您和家人在这里度过了愉快的时光！我们会把您的表扬转达给行政酒廊的同事。', '2026-06-07 10:00:00', 1, 'user108', '2026-06-05 16:00:00', '', '2026-06-07 10:00:00', NULL, NULL, NULL, '0');
INSERT INTO `comment` VALUES (35, 108, 4, 14, 117, 2, '入住体验非常糟糕。预订的豪华大床房到了前台被告知没有了，被安排了一个标间。前台解释说系统出错了，但也没有给出任何补偿方案。房间内空调噪音很大，影响睡眠。作为香格里拉品牌，这样的服务实在令人失望。', '[]', '0', '1', 12, NULL, NULL, NULL, 'user108', '2026-06-08 09:00:00', '', '2026-06-08 09:00:00', '系统显示客人预订的就是标间，客人记错了', '2026-06-08 14:00:00', '1');
INSERT INTO `comment` VALUES (36, 103, 2, 6, 118, 5, '又来上海出差，这次住在华尔道夫。外滩的夜景永远看不腻！酒店的服务依然出色，前台还记得我上次住的偏好，非常贴心。房间升级到了江景套房，视野无敌。早餐在顶楼餐厅吃，美食配美景，太完美了。', '[\"https://images.unsplash.com/photo-1551882547-be7b2a60087d?w=400&h=300&fit=crop\",\"https://images.unsplash.com/photo-1544551763-46a013bb70d5?w=400&h=300&fit=crop\"]', '0', '1', 16, '欢迎回来！很高兴能再次为您服务。外滩的夜景确实百看不厌，期待您的下一次光临。', '2026-06-08 10:00:00', 1, 'user103', '2026-06-07 14:00:00', '', '2026-06-08 10:00:00', NULL, NULL, NULL, '0');

-- ----------------------------
-- Table structure for gen_table
-- ----------------------------
DROP TABLE IF EXISTS `gen_table`;
CREATE TABLE `gen_table`  (
  `table_id` bigint NOT NULL AUTO_INCREMENT COMMENT '编号',
  `table_name` varchar(200) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT '' COMMENT '表名称',
  `table_comment` varchar(500) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT '' COMMENT '表描述',
  `sub_table_name` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL COMMENT '关联子表的表名',
  `sub_table_fk_name` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL COMMENT '子表关联的外键名',
  `class_name` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT '' COMMENT '实体类名称',
  `tpl_category` varchar(200) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT 'crud' COMMENT '使用的模板（crud单表操作 tree树表操作）',
  `tpl_web_type` varchar(30) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT '' COMMENT '前端模板类型（element-ui模版 element-plus模版）',
  `package_name` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL COMMENT '生成包路径',
  `module_name` varchar(30) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL COMMENT '生成模块名',
  `business_name` varchar(30) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL COMMENT '生成业务名',
  `function_name` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL COMMENT '生成功能名',
  `function_author` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL COMMENT '生成功能作者',
  `gen_type` char(1) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT '0' COMMENT '生成代码方式（0zip压缩包 1自定义路径）',
  `gen_path` varchar(200) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT '/' COMMENT '生成路径（不填默认项目路径）',
  `options` varchar(1000) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL COMMENT '其它生成选项',
  `create_by` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT '' COMMENT '创建者',
  `create_time` datetime NULL DEFAULT NULL COMMENT '创建时间',
  `update_by` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT '' COMMENT '更新者',
  `update_time` datetime NULL DEFAULT NULL COMMENT '更新时间',
  `remark` varchar(500) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL COMMENT '备注',
  PRIMARY KEY (`table_id`) USING BTREE
) ENGINE = InnoDB AUTO_INCREMENT = 7 CHARACTER SET = utf8mb4 COLLATE = utf8mb4_0900_ai_ci COMMENT = '代码生成业务表' ROW_FORMAT = DYNAMIC;

-- ----------------------------
-- Records of gen_table
-- ----------------------------

-- ----------------------------
-- Table structure for gen_table_column
-- ----------------------------
DROP TABLE IF EXISTS `gen_table_column`;
CREATE TABLE `gen_table_column`  (
  `column_id` bigint NOT NULL AUTO_INCREMENT COMMENT '编号',
  `table_id` bigint NULL DEFAULT NULL COMMENT '归属表编号',
  `column_name` varchar(200) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL COMMENT '列名称',
  `column_comment` varchar(500) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL COMMENT '列描述',
  `column_type` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL COMMENT '列类型',
  `java_type` varchar(500) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL COMMENT 'JAVA类型',
  `java_field` varchar(200) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL COMMENT 'JAVA字段名',
  `is_pk` char(1) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL COMMENT '是否主键（1是）',
  `is_increment` char(1) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL COMMENT '是否自增（1是）',
  `is_required` char(1) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL COMMENT '是否必填（1是）',
  `is_insert` char(1) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL COMMENT '是否为插入字段（1是）',
  `is_edit` char(1) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL COMMENT '是否编辑字段（1是）',
  `is_list` char(1) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL COMMENT '是否列表字段（1是）',
  `is_query` char(1) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL COMMENT '是否查询字段（1是）',
  `query_type` varchar(200) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT 'EQ' COMMENT '查询方式（等于、不等于、大于、小于、范围）',
  `html_type` varchar(200) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL COMMENT '显示类型（文本框、文本域、下拉框、复选框、单选框、日期控件）',
  `dict_type` varchar(200) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT '' COMMENT '字典类型',
  `sort` int NULL DEFAULT NULL COMMENT '排序',
  `create_by` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT '' COMMENT '创建者',
  `create_time` datetime NULL DEFAULT NULL COMMENT '创建时间',
  `update_by` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT '' COMMENT '更新者',
  `update_time` datetime NULL DEFAULT NULL COMMENT '更新时间',
  PRIMARY KEY (`column_id`) USING BTREE
) ENGINE = InnoDB AUTO_INCREMENT = 80 CHARACTER SET = utf8mb4 COLLATE = utf8mb4_0900_ai_ci COMMENT = '代码生成业务表字段' ROW_FORMAT = DYNAMIC;

-- ----------------------------
-- Records of gen_table_column
-- ----------------------------

-- ----------------------------
-- Table structure for hotel
-- ----------------------------
DROP TABLE IF EXISTS `hotel`;
CREATE TABLE `hotel`  (
  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '酒店ID',
  `name` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NOT NULL COMMENT '酒店名称',
  `address` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NOT NULL COMMENT '酒店地址',
  `star` int NULL DEFAULT NULL COMMENT '酒店星级',
  `score` decimal(3, 2) NULL DEFAULT NULL COMMENT '酒店评分',
  `img_url` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT NULL COMMENT '酒店图片URL',
  `facility` text CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL COMMENT '酒店设施',
  `business_id` bigint NULL DEFAULT NULL COMMENT '商家ID',
  `status` char(1) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NULL DEFAULT '0' COMMENT '状态（0正常 1停用）',
  `create_time` datetime NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `update_time` datetime NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
  PRIMARY KEY (`id`) USING BTREE,
  INDEX `idx_name`(`name` ASC) USING BTREE,
  INDEX `idx_status`(`status` ASC) USING BTREE
) ENGINE = InnoDB AUTO_INCREMENT = 101 CHARACTER SET = utf8mb4 COLLATE = utf8mb4_0900_ai_ci COMMENT = '酒店表' ROW_FORMAT = DYNAMIC;

-- ----------------------------
-- Records of hotel
-- ----------------------------
INSERT INTO `hotel` VALUES (1, '北京王府井希尔顿酒店', '北京市东城区王府井大街88号', 5, 4.80, 'https://example.com/hotel1.jpg', 'WiFi,停车场,游泳池,健身房,SPA,餐厅,会议室', 1001, '0', '2026-05-29 20:48:19', '2026-05-29 20:48:19');
INSERT INTO `hotel` VALUES (2, '上海外滩华尔道夫酒店', '上海市黄浦区中山东一路2号', 5, 4.90, 'https://example.com/hotel2.jpg', 'WiFi,停车场,游泳池,健身房,SPA,餐厅,酒吧,商务中心', 1002, '0', '2026-05-29 20:48:19', '2026-05-29 20:48:19');
INSERT INTO `hotel` VALUES (3, '广州塔丽思卡尔顿酒店', '广州市天河区珠江新城兴民路222号', 5, 4.70, 'https://example.com/hotel3.jpg', 'WiFi,停车场,游泳池,健身房,SPA,餐厅,儿童乐园', 1003, '0', '2026-05-29 20:48:19', '2026-05-29 20:48:19');
INSERT INTO `hotel` VALUES (4, '深圳福田香格里拉大酒店', '深圳市福田区中心城益田路4088号', 5, 4.60, 'https://example.com/hotel4.jpg', 'WiFi,停车场,游泳池,健身房,SPA,餐厅,会议室,商务中心', 1004, '0', '2026-05-29 20:48:19', '2026-05-29 20:48:19');
INSERT INTO `hotel` VALUES (5, '杭州西湖国宾馆', '杭州市西湖区杨公堤18号', 4, 4.50, 'https://example.com/hotel5.jpg', 'WiFi,停车场,餐厅,花园,湖景房,会议室', 1005, '0', '2026-05-29 20:48:19', '2026-05-29 20:48:19');
INSERT INTO `hotel` VALUES (6, '成都太古里尼依格罗酒店', '成都市锦江区红星路三段1号', 5, 4.80, 'https://example.com/hotel6.jpg', 'WiFi,停车场,游泳池,健身房,SPA,餐厅,酒吧', 1006, '0', '2026-05-29 20:48:19', '2026-05-29 20:48:19');
INSERT INTO `hotel` VALUES (7, '西安钟楼开元酒店', '西安市碑林区南大街30号', 4, 4.30, 'https://example.com/hotel7.jpg', 'WiFi,停车场,餐厅,会议室,商务中心', 1007, '0', '2026-05-29 20:48:19', '2026-05-29 20:48:19');
INSERT INTO `hotel` VALUES (8, '三亚亚龙湾瑞吉度假酒店', '三亚市吉阳区亚龙湾国家旅游度假区', 5, 4.90, 'https://example.com/hotel8.jpg', 'WiFi,停车场,私人海滩,游泳池,健身房,SPA,餐厅,儿童俱乐部', 1008, '0', '2026-05-29 20:48:19', '2026-05-29 20:48:19');
INSERT INTO `hotel` VALUES (9, '厦门鼓浪屿海景酒店', '厦门市思明区鼓浪屿康泰路151号', 4, 4.40, 'https://example.com/hotel9.jpg', 'WiFi,海景房,餐厅,花园,露台', 1009, '0', '2026-05-29 20:48:19', '2026-05-29 20:48:19');
