<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zsc.module.mapper.OrderMapper">

    <resultMap id="OrderVoResultMap" type="com.zsc.module.domain.vo.OrderVo">
        <id property="id" column="id"/>
        <result property="orderNo" column="order_no"/>
        <result property="userId" column="user_id"/>
        <result property="hotelId" column="hotel_id"/>
        <result property="roomId" column="room_id"/>
        <result property="startDate" column="start_date"/>
        <result property="endDate" column="end_date"/>
        <result property="totalPrice" column="total_price"/>
        <result property="status" column="status"/>
        <result property="payTime" column="pay_time"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="userName" column="user_name"/>
        <result property="hotelName" column="hotel_name"/>
        <result property="hotelImage" column="hotel_image"/>
        <result property="roomType" column="room_type"/>
        <result property="payTypeName" column="pay_type_name"/>
        <result property="transactionId" column="transaction_id"/>
        <result property="payAmount" column="pay_amount"/>
        <result property="reviewed" column="reviewed"/>
    </resultMap>

    <sql id="selectOrderVo">
        SELECT o.id, o.order_no, o.user_id, o.hotel_id, o.room_id,
               o.start_date, o.end_date, o.total_price, o.status,
               o.pay_time, o.create_time, o.update_time,
               u.nick_name AS user_name,
               h.name AS hotel_name,
               h.img_url AS hotel_image,
               r.room_type,
               CASE p.pay_type
                   WHEN '1' THEN '微信'
                   WHEN '2' THEN '支付宝'
                   WHEN '3' THEN '银行卡'
                   ELSE '未知'
               END AS pay_type_name,
               p.transaction_id,
               p.pay_amount,
               (SELECT COUNT(1) FROM `comment` c WHERE c.order_id = o.id) > 0 AS reviewed
        FROM orders o
        LEFT JOIN sys_user u ON o.user_id = u.user_id
        LEFT JOIN hotel h ON o.hotel_id = h.id
        LEFT JOIN room r ON o.room_id = r.id
        LEFT JOIN payment p ON o.id = p.order_id
    </sql>

    <sql id="whereClause">
        <where>
            <if test="query.orderNo != null and query.orderNo != ''">
                AND o.order_no LIKE CONCAT('%', #{query.orderNo}, '%')
            </if>
            <if test="query.userId != null">
                AND o.user_id = #{query.userId}
            </if>
            <if test="query.hotelIds != null and query.hotelIds.size() > 0">
                AND o.hotel_id IN
                <foreach collection="query.hotelIds" item="hid" open="(" separator="," close=")">
                    #{hid}
                </foreach>
            </if>
            <if test="(query.hotelIds == null or query.hotelIds.size() == 0) and query.hotelId != null">
                AND o.hotel_id = #{query.hotelId}
            </if>
            <if test="query.roomId != null">
                AND o.room_id = #{query.roomId}
            </if>
            <if test="query.statusList != null and query.statusList.size() > 0">
                AND o.status IN
                <foreach collection="query.statusList" item="s" open="(" separator="," close=")">
                    #{s}
                </foreach>
            </if>
            <if test="(query.statusList == null or query.statusList.size() == 0) and query.status != null and query.status != ''">
                AND o.status = #{query.status}
            </if>
            <if test="query.beginTime != null and query.beginTime != ''">
                AND o.create_time &gt;= #{query.beginTime}
            </if>
            <if test="query.endTime != null and query.endTime != ''">
                AND o.create_time &lt;= #{query.endTime}
            </if>
            <if test="query.keyword != null and query.keyword != ''">
                AND (o.order_no LIKE CONCAT('%', #{query.keyword}, '%')
                     OR u.nick_name LIKE CONCAT('%', #{query.keyword}, '%')
                     OR h.name LIKE CONCAT('%', #{query.keyword}, '%'))
            </if>
        </where>
    </sql>

    <select id="selectOrderVoPage" resultMap="OrderVoResultMap">
        <include refid="selectOrderVo"/>
        <include refid="whereClause"/>
        <choose>
            <when test="query.orderBy != null and query.orderBy != ''">
                ORDER BY ${query.orderBy}
            </when>
            <otherwise>
                ORDER BY o.create_time DESC
            </otherwise>
        </choose>
    </select>

    <select id="selectOrderVoById" resultMap="OrderVoResultMap">
        <include refid="selectOrderVo"/>
        WHERE o.id = #{id}
    </select>

    <select id="countOrders" resultType="java.lang.Long">
        SELECT COUNT(1) FROM orders o
        LEFT JOIN sys_user u ON o.user_id = u.user_id
        LEFT JOIN hotel h ON o.hotel_id = h.id
        <include refid="whereClause"/>
    </select>

    <select id="selectUserOrderVoById" resultMap="OrderVoResultMap">
        <include refid="selectOrderVo"/>
        WHERE o.id = #{id} AND o.user_id = #{userId}
    </select>

    <select id="countUserOrdersByStatus" resultType="java.lang.Long">
        SELECT COUNT(1) FROM orders o
        WHERE o.user_id = #{userId}
        <if test="status != null and status != ''">
            AND o.status = #{status}
        </if>
    </select>

    <select id="countUserOrders" resultType="java.lang.Long">
        SELECT COUNT(1) FROM orders o WHERE o.user_id = #{userId}
    </select>

    <select id="countUserPendingReviewOrders" resultType="java.lang.Long">
        SELECT COUNT(1) FROM orders o
        WHERE o.user_id = #{userId}
        AND o.status = '3'
        AND NOT EXISTS (
            SELECT 1 FROM comment c WHERE c.order_id = o.id AND c.user_id = o.user_id
        )
    </select>

    <!-- ===== 商户统计专用SQL ===== -->

    <select id="countOrdersByHotelIds" resultType="java.lang.Long">
        SELECT COUNT(1) FROM orders o
        WHERE 1=1
        <if test="hotelIds != null and hotelIds.size() > 0">
            AND o.hotel_id IN
            <foreach collection="hotelIds" item="hotelId" open="(" separator="," close=")">
                #{hotelId}
            </foreach>
        </if>
        <if test="hotelIds == null or hotelIds.size() == 0">
            AND 1=0
        </if>
    </select>

    <select id="sumRevenueByHotelIds" resultType="java.math.BigDecimal">
        SELECT COALESCE(SUM(o.total_price), 0) FROM orders o
        WHERE o.status IN ('1', '3')
        <if test="hotelIds != null and hotelIds.size() > 0">
            AND o.hotel_id IN
            <foreach collection="hotelIds" item="hotelId" open="(" separator="," close=")">
                #{hotelId}
            </foreach>
        </if>
        <if test="hotelIds == null or hotelIds.size() == 0">
            AND 1=0
        </if>
    </select>

    <select id="countTodayOrdersByHotelIds" resultType="java.lang.Long">
        SELECT COUNT(1) FROM orders o
        WHERE 1=1
        <if test="hotelIds != null and hotelIds.size() > 0">
            AND o.hotel_id IN
            <foreach collection="hotelIds" item="hotelId" open="(" separator="," close=")">
                #{hotelId}
            </foreach>
        </if>
        <if test="hotelIds == null or hotelIds.size() == 0">
            AND 1=0
        </if>
        AND DATE(o.create_time) = CURDATE()
    </select>

    <select id="sumMonthRevenueByHotelIds" resultType="java.math.BigDecimal">
        SELECT COALESCE(SUM(o.total_price), 0) FROM orders o
        WHERE o.status IN ('1', '3')
        <if test="hotelIds != null and hotelIds.size() > 0">
            AND o.hotel_id IN
            <foreach collection="hotelIds" item="hotelId" open="(" separator="," close=")">
                #{hotelId}
            </foreach>
        </if>
        <if test="hotelIds == null or hotelIds.size() == 0">
            AND 1=0
        </if>
        AND DATE_FORMAT(o.create_time, '%Y-%m') = DATE_FORMAT(CURDATE(), '%Y-%m')
    </select>

    <select id="countOrdersByStatusAndHotelIds" resultType="java.lang.Long">
        SELECT COUNT(1) FROM orders o
        WHERE 1=1
        <if test="hotelIds != null and hotelIds.size() > 0">
            AND o.hotel_id IN
            <foreach collection="hotelIds" item="hotelId" open="(" separator="," close=")">
                #{hotelId}
            </foreach>
        </if>
        <if test="hotelIds == null or hotelIds.size() == 0">
            AND 1=0
        </if>
        AND o.status = #{status}
    </select>

    <select id="selectDailyRevenue" resultType="com.zsc.module.domain.vo.DailyRevenueVo">
        SELECT DATE(o.create_time) AS date,
               COALESCE(SUM(o.total_price), 0) AS revenue,
               COUNT(1) AS orderCount
        FROM orders o
        WHERE o.status IN ('1', '3')
        <if test="hotelIds != null and hotelIds.size() > 0">
            AND o.hotel_id IN
            <foreach collection="hotelIds" item="hotelId" open="(" separator="," close=")">
                #{hotelId}
            </foreach>
        </if>
        <if test="hotelIds == null or hotelIds.size() == 0">
            AND 1=0
        </if>
        AND o.create_time &gt;= DATE_SUB(CURDATE(), INTERVAL #{days} DAY)
        GROUP BY DATE(o.create_time)
        ORDER BY date ASC
    </select>

    <select id="selectDailyOrderCount" resultType="com.zsc.module.domain.vo.DailyRevenueVo">
        SELECT DATE(o.create_time) AS date,
               0 AS revenue,
               COUNT(1) AS orderCount
        FROM orders o
        WHERE 1=1
        <if test="hotelIds != null and hotelIds.size() > 0">
            AND o.hotel_id IN
            <foreach collection="hotelIds" item="hotelId" open="(" separator="," close=")">
                #{hotelId}
            </foreach>
        </if>
        <if test="hotelIds == null or hotelIds.size() == 0">
            AND 1=0
        </if>
        AND o.create_time &gt;= DATE_SUB(CURDATE(), INTERVAL #{days} DAY)
        GROUP BY DATE(o.create_time)
        ORDER BY date ASC
    </select>

    <select id="sumRevenueByHotelIdsAndDateRange" resultType="java.math.BigDecimal">
        SELECT COALESCE(SUM(o.total_price), 0) FROM orders o
        WHERE o.status IN ('1', '3')
        <if test="hotelIds != null and hotelIds.size() > 0">
            AND o.hotel_id IN
            <foreach collection="hotelIds" item="hotelId" open="(" separator="," close=")">
                #{hotelId}
            </foreach>
        </if>
        <if test="hotelIds == null or hotelIds.size() == 0">
            AND 1=0
        </if>
        <if test="beginTime != null and beginTime != ''">
            AND o.create_time &gt;= #{beginTime}
        </if>
        <if test="endTime != null and endTime != ''">
            AND o.create_time &lt;= #{endTime}
        </if>
    </select>

    <select id="countOrdersByHotelIdsAndDateRange" resultType="java.lang.Long">
        SELECT COUNT(1) FROM orders o
        WHERE 1=1
        <if test="hotelIds != null and hotelIds.size() > 0">
            AND o.hotel_id IN
            <foreach collection="hotelIds" item="hotelId" open="(" separator="," close=")">
                #{hotelId}
            </foreach>
        </if>
        <if test="hotelIds == null or hotelIds.size() == 0">
            AND 1=0
        </if>
        <if test="beginTime != null and beginTime != ''">
            AND o.create_time &gt;= #{beginTime}
        </if>
        <if test="endTime != null and endTime != ''">
            AND o.create_time &lt;= #{endTime}
        </if>
    </select>

    <select id="selectDailyRevenueByDateRange" resultType="com.zsc.module.domain.vo.DailyRevenueVo">
        SELECT DATE(o.create_time) AS date,
               COALESCE(SUM(o.total_price), 0) AS revenue,
               COUNT(1) AS orderCount
        FROM orders o
        WHERE o.status IN ('1', '3')
        <if test="hotelIds != null and hotelIds.size() > 0">
            AND o.hotel_id IN
            <foreach collection="hotelIds" item="hotelId" open="(" separator="," close=")">
                #{hotelId}
            </foreach>
        </if>
        <if test="hotelIds == null or hotelIds.size() == 0">
            AND 1=0
        </if>
        <if test="beginTime != null and beginTime != ''">
            AND o.create_time &gt;= #{beginTime}
        </if>
        <if test="endTime != null and endTime != ''">
            AND o.create_time &lt;= #{endTime}
        </if>
        GROUP BY DATE(o.create_time)
        ORDER BY date ASC
    </select>

</mapper>
