<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zsc.module.mapper.HotelAuditMapper">

    <resultMap type="com.zsc.module.domain.vo.HotelAuditVo" id="HotelAuditVoResult">
        <result property="id" column="id"/>
        <result property="hotelId" column="hotel_id"/>
        <result property="hotelName" column="hotel_name"/>
        <result property="hotelAddress" column="hotel_address"/>
        <result property="hotelStar" column="hotel_star"/>
        <result property="businessId" column="business_id"/>
        <result property="auditStatus" column="audit_status"/>
        <result property="auditOpinion" column="audit_opinion"/>
        <result property="auditorId" column="auditor_id"/>
        <result property="auditorName" column="auditor_name"/>
        <result property="submitTime" column="submit_time"/>
        <result property="auditTime" column="audit_time"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <!-- 分页查询酒店审核记录（联查酒店表） -->
    <select id="selectHotelAuditPage" resultMap="HotelAuditVoResult">
        SELECT ha.id,
               ha.hotel_id,
               h.name       AS hotel_name,
               h.address    AS hotel_address,
               h.star       AS hotel_star,
               h.business_id,
               ha.audit_status,
               ha.audit_opinion,
               ha.auditor_id,
               ha.auditor_name,
               ha.submit_time,
               ha.audit_time,
               ha.create_time
        FROM hotel_audit ha
                 LEFT JOIN hotel h ON ha.hotel_id = h.id
        <where>
            <if test="query.hotelId != null">
                AND ha.hotel_id = #{query.hotelId}
            </if>
            <if test="query.hotelName != null and query.hotelName != ''">
                AND h.name LIKE CONCAT('%', #{query.hotelName}, '%')
            </if>
            <if test="query.auditStatus != null and query.auditStatus != ''">
                AND ha.audit_status = #{query.auditStatus}
            </if>
        </where>
        ORDER BY ha.create_time DESC
    </select>

    <!-- 查询待审核数量 -->
    <select id="selectPendingCount" resultType="int">
        SELECT COUNT(*)
        FROM hotel_audit
        WHERE audit_status = '0'
    </select>

</mapper>
